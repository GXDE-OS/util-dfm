# Maintainer: CharOfString <root@charofstring.cc>
pkgname=util-dfm
pkgver=1.3.71
pkgrel=1
pkgdesc='Utility libraries of the GXDE/deepin file manager (dfm6-io, -mount, -burn, -search)'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/util-dfm"
license=('GPL-3.0-or-later' 'MIT' 'ClArtistic')
depends=('gxde-dtk6core' 'qt6-base' 'glib2' 'glibmm' 'udisks2' 'libisoburn' 'libmediainfo' 'libsecret'
         'lucene++' 'openssl' 'util-linux-libs' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'boost' 'qt6-tools')
# Debian 拆成各库及其 -dev 包，这里没有文件冲突，按 Arch 惯例合并
# Debian splits it into one package per library plus -dev packages; nothing
# collides here, so it is a single package as usual on Arch.
provides=('deepin-util-dfm' "util-dfm-git=$pkgver")
conflicts=('deepin-util-dfm' 'util-dfm-git')
replaces=('util-dfm-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DVERSION="$pkgver"
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  # MIT 与 ClArtistic 需随包附带许可证文本 ・ MIT and ClArtistic need their license texts.
  install -Dm644 "$(_srcroot)"/LICENSES/{MIT,ClArtistic}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
